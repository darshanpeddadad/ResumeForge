# Database Connection (Neon, Supabase, or PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/resume_db

# Better Auth Configuration
BETTER_AUTH_SECRET=generate_a_random_32_char_secret_here_or_use_openssl
BETTER_AUTH_URL=http://localhost:3000

# Optional: Dedicated Encryption Secret for user API keys (defaults to BETTER_AUTH_SECRET if not set)
# ENCRYPTION_SECRET=generate_a_random_32_char_secret_here_or_use_openssl
